+package com.github.gezimos.inkos.ui
+
+// inkOS-Patcher: page-indicator-options patch.
+// Extra options for the home-screen page counter (the dot column beside the home apps):
+//   - Side: Auto (vanilla: opposite the apps), Left or Right. Left/Right draw it in the empty
+//     side margin outside the apps, so it never covers an app label.
+//   - Auto-hide: N seconds after the page last changed, the counter fades out. It fades back in
+//     on the next page change and whenever Home regains window focus.
+//   - Fades To: how far auto-hide fades it: 0% = gone, or a faint 10-90%.
+//   - Fade: Smooth (animated; also follows the system animation scale) or Instant (pops on and
+//     off in one frame, so e-ink screens don't flicker through grey in-between frames).
+//   - Opacity: how visible the whole counter is while shown.
+//   - Dot style: Classic (vanilla) or Pill (small dimmed dots, the current page drawn as a
+//     long pill, on a translucent backing).
+// Settings rows are marked ✦ and indented under "Enable Page Indicator" ([PatcherSubSetting]).
+// Upstream files only get small hooks: Prefs (6 values), HomeUI (one call), SettingsFragment (6 rows).
+
+import android.content.SharedPreferences
+import android.view.ViewTreeObserver
+import androidx.compose.animation.core.Animatable
+import androidx.compose.animation.core.tween
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.BoxScope
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.offset
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.layout.width
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.State
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import com.github.gezimos.inkos.data.Prefs
+import com.github.gezimos.inkos.style.rememberScreenScale
+import com.github.gezimos.inkos.style.scaled
+import com.github.gezimos.inkos.ui.compose.PageIndicator
+import kotlinx.coroutines.delay
+
+object PageIndicatorOptions {
+    const val KEY_SIDE = "PAGE_INDICATOR_SIDE"
+    const val KEY_AUTO_HIDE = "PAGE_INDICATOR_AUTO_HIDE"
+    const val KEY_OPACITY = "PAGE_INDICATOR_OPACITY"
+    const val KEY_STYLE = "PAGE_INDICATOR_STYLE"
+    const val KEY_FADED_OPACITY = "PAGE_INDICATOR_FADED_OPACITY"
+    const val KEY_FADE_STYLE = "PAGE_INDICATOR_FADE_STYLE"
+    private val KEYS = setOf(KEY_SIDE, KEY_AUTO_HIDE, KEY_OPACITY, KEY_STYLE, KEY_FADED_OPACITY, KEY_FADE_STYLE)
+
+    const val SIDE_AUTO = 0
+    const val SIDE_LEFT = 1
+    const val SIDE_RIGHT = 2
+    const val SIDE_COUNT = 3
+
+    /** Auto-hide choices in seconds; 0 = never hide. */
+    val AUTO_HIDE_SECONDS = listOf(0, 1, 2, 5, 10)
+
+    const val STYLE_CLASSIC = 0
+    const val STYLE_PILL = 1
+    const val STYLE_COUNT = 2
+
+    const val OPACITY_MIN = 10
+    const val OPACITY_MAX = 100
+
+    /** Auto-hide fades to this opacity, in percent; 0 = gone. */
+    const val FADED_OPACITY_MIN = 0
+    const val FADED_OPACITY_MAX = 90
+
+    const val FADE_SMOOTH = 0
+    const val FADE_INSTANT = 1
+    const val FADE_STYLE_COUNT = 2
+
+    const val FADE_IN_MS = 250
+    const val FADE_OUT_MS = 600
+
+    /** The auto-hide choice after [current], wrapping around. Unknown values restart at "off". */
+    fun nextAutoHide(current: Int): Int {
+        val index = AUTO_HIDE_SECONDS.indexOf(current)
+        return AUTO_HIDE_SECONDS[(index + 1) % AUTO_HIDE_SECONDS.size]
+    }
+
+    fun isOptionKey(key: String?): Boolean = key in KEYS
+}
+
+data class PageIndicatorSettings(
+    val side: Int,
+    val autoHideSeconds: Int,
+    val opacity: Int,
+    val style: Int,
+    val fadedOpacity: Int,
+    val fadeStyle: Int
+) {
+    companion object {
+        fun read(prefs: Prefs) = PageIndicatorSettings(
+            side = prefs.pageIndicatorSide,
+            autoHideSeconds = prefs.pageIndicatorAutoHide,
+            opacity = prefs.pageIndicatorOpacity,
+            style = prefs.pageIndicatorStyle,
+            fadedOpacity = prefs.pageIndicatorFadedOpacity,
+            fadeStyle = prefs.pageIndicatorFadeStyle
+        )
+    }
+}
+
+/** The settings as Compose state, updated as soon as Settings writes them. */
+@Composable
+fun rememberPageIndicatorSettings(prefs: Prefs): State<PageIndicatorSettings> {
+    val settings = remember(prefs) { mutableStateOf(PageIndicatorSettings.read(prefs)) }
+    DisposableEffect(prefs) {
+        // SharedPreferences keeps listeners weakly; onDispose below holds this one strongly.
+        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, key ->
+            if (PageIndicatorOptions.isOptionKey(key)) settings.value = PageIndicatorSettings.read(prefs)
+        }
+        prefs.sharedPrefs.registerOnSharedPreferenceChangeListener(listener)
+        onDispose { prefs.sharedPrefs.unregisterOnSharedPreferenceChangeListener(listener) }
+    }
+    return settings
+}
+
+/**
+ * Draws the home page counter with the patch's options. Takes the same values HomeUI passed to
+ * the vanilla [PageIndicator], plus [homeAlignment] (for Side = Auto), [yOffset] (the home apps'
+ * vertical offset), [gutter] (the side margin outside the apps) and [showEditMode].
+ */
+@Composable
+fun BoxScope.PatchedPageIndicator(
+    prefs: Prefs,
+    currentPage: Int,
+    totalPages: Int,
+    color: Color,
+    showTextIslands: Boolean,
+    textIslandsInverted: Boolean,
+    textIslandsShape: Int,
+    dotSize: Dp,
+    dotSpacing: Dp,
+    borderWidth: Dp,
+    homeAlignment: Int,
+    yOffset: Dp,
+    gutter: Dp,
+    showEditMode: Boolean
+) {
+    val settings by rememberPageIndicatorSettings(prefs)
+    val shownAgainCount = rememberWindowFocusGainCount()
+
+    val shownAlpha = settings.opacity / 100f
+    // Fading to more than the shown opacity would make "hidden" brighter than "shown".
+    val fadedAlpha = minOf(settings.fadedOpacity, settings.opacity) / 100f
+    val autoHides = settings.autoHideSeconds > 0 && !showEditMode
+
+    // With auto-hide on, the counter starts faded and fades in, like after a page change.
+    val alpha = remember { Animatable(if (autoHides) fadedAlpha else shownAlpha) }
+    val instant = settings.fadeStyle == PageIndicatorOptions.FADE_INSTANT
+    LaunchedEffect(currentPage, settings, showEditMode, shownAgainCount) {
+        if (instant) alpha.snapTo(shownAlpha)
+        else alpha.animateTo(shownAlpha, tween(PageIndicatorOptions.FADE_IN_MS))
+        if (autoHides) {
+            delay(settings.autoHideSeconds * 1000L)
+            if (instant) alpha.snapTo(fadedAlpha)
+            else alpha.animateTo(fadedAlpha, tween(PageIndicatorOptions.FADE_OUT_MS))
+        }
+    }
+
+    val placement = when (settings.side) {
+        // A gutter-wide box just outside the apps' area, with the counter centered in it.
+        PageIndicatorOptions.SIDE_LEFT -> Modifier
+            .align(Alignment.CenterStart)
+            .offset(x = -gutter, y = yOffset)
+            .width(gutter)
+        PageIndicatorOptions.SIDE_RIGHT -> Modifier
+            .align(Alignment.CenterEnd)
+            .offset(x = gutter, y = yOffset)
+            .width(gutter)
+        // Vanilla placement: opposite side to right-aligned apps, otherwise on the right.
+        else -> Modifier
+            .align(if (homeAlignment == 2) Alignment.CenterStart else Alignment.CenterEnd)
+            .offset(y = yOffset)
+    }
+
+    Box(
+        // Read while drawing, so the fade redraws the layer without recomposing the dots.
+        modifier = placement.graphicsLayer { this.alpha = alpha.value },
+        contentAlignment = Alignment.Center
+    ) {
+        if (settings.style == PageIndicatorOptions.STYLE_PILL) {
+            PillPageIndicator(
+                currentPage = currentPage,
+                totalPages = totalPages,
+                color = color,
+                dotSize = dotSize
+            )
+        } else {
+            PageIndicator(
+                currentPage = currentPage,
+                totalPages = totalPages,
+                color = color,
+                showTextIslands = showTextIslands,
+                textIslandsInverted = textIslandsInverted,
+                textIslandsShape = textIslandsShape,
+                dotSize = dotSize,
+                dotSpacing = dotSpacing,
+                borderWidth = borderWidth
+            )
+        }
+    }
+}
+
+/**
+ * Vertical version of android_shortcut_hub's widget-stack page dots. At the default 12dp dot
+ * size it matches the hub: 6dp dots, a 14dp pill for the current page, 5dp apart, on a
+ * translucent rounded backing. Colors follow the inkOS theme instead of Material colors.
+ */
+@Composable
+private fun PillPageIndicator(
+    currentPage: Int,
+    totalPages: Int,
+    color: Color,
+    dotSize: Dp
+) {
+    val base = dotSize / 2
+    val pillShape = RoundedCornerShape(50)
+    Column(
+        modifier = Modifier
+            .background(color.copy(alpha = 0.15f), pillShape)
+            .padding(horizontal = base * 4f / 6f, vertical = base * 7f / 6f),
+        verticalArrangement = Arrangement.spacedBy(base * 5f / 6f),
+        horizontalAlignment = Alignment.CenterHorizontally
+    ) {
+        repeat(totalPages) { index ->
+            val active = index == currentPage
+            Box(
+                modifier = Modifier
+                    .size(width = base, height = if (active) base * 14f / 6f else base)
+                    .background(if (active) color else color.copy(alpha = 0.4f), pillShape)
+            )
+        }
+    }
+}
+
+/** Counts how often this window regained focus, e.g. when returning Home from another app. */
+@Composable
+private fun rememberWindowFocusGainCount(): Int {
+    val view = LocalView.current
+    var count by remember { mutableIntStateOf(0) }
+    DisposableEffect(view) {
+        val listener = ViewTreeObserver.OnWindowFocusChangeListener { hasFocus ->
+            if (hasFocus) count++
+        }
+        view.viewTreeObserver.addOnWindowFocusChangeListener(listener)
+        onDispose { view.viewTreeObserver.removeOnWindowFocusChangeListener(listener) }
+    }
+    return count
+}
+
+/**
+ * Indents a patcher-only settings row under its master setting, [level] steps of 16dp. Start
+ * side only: SettingsSelect's own horizontalPadding pads both sides, which would also shift the
+ * value column away from the stock rows.
+ */
+@Composable
+fun PatcherSubSetting(level: Int = 1, content: @Composable () -> Unit) {
+    Box(modifier = Modifier.padding(start = 16.dp.scaled(rememberScreenScale()) * level)) {
+        content()
+    }
+}
