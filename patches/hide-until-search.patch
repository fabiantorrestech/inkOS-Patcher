@@ -0,0 +1,29 @@
+package com.github.gezimos.inkos.ui
+
+/**
+ * inkOS-Patcher: decides when the normal app drawer lists anything.
+ *
+ * Pure rules, no Android code. AppsFragment asks these questions; Prefs stores the mode.
+ */
+object DrawerReveal {
+    const val ALWAYS = 0            // vanilla inkOS: full list when the search box is empty
+    const val WHILE_TYPING = 1      // empty until the search box has text
+    const val AFTER_SEARCH_KEY = 2  // empty until Search is pressed for the current text
+    const val DEFAULT = AFTER_SEARCH_KEY
+    const val MODE_COUNT = 3
+
+    /** Only the normal drawer is gated, and only when there is a search box to reveal it with. */
+    fun gateApplies(mode: Int, isLaunchDrawer: Boolean, searchAvailable: Boolean): Boolean =
+        mode != ALWAYS && isLaunchDrawer && searchAvailable
+
+    /** Whether the drawer may list results for [query]. [submittedQuery] is the text Search was last pressed for. */
+    fun showsResults(mode: Int, query: String, submittedQuery: String?): Boolean = when (mode) {
+        WHILE_TYPING -> query.isNotBlank()
+        AFTER_SEARCH_KEY -> query.isNotBlank() && submittedQuery == query
+        else -> true
+    }
+
+    /** True when pressing Search should reveal results instead of launching the first one. */
+    fun needsSubmit(mode: Int, query: String, submittedQuery: String?): Boolean =
+        mode == AFTER_SEARCH_KEY && submittedQuery != query
+}
