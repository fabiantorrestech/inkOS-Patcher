+import com.github.gezimos.inkos.data.Prefs
+
+/**
+ * inkOS-Patcher: custom home page sizes ("page-layout" patch).
+ *
+ * Stock inkOS splits the home slots evenly: ceil(slots / pages) per page. Arrange Pages
+ * (ui/PageLayoutEditor.kt) saves one size per page instead, e.g. "3,0,5" = 3 slots,
+ * an empty page, then 5 slots. A saved layout is used only while it still matches
+ * "Number of home apps" and "Number of pages"; change either one and Home falls back
+ * to the stock even split.
+ *
+ * A "boundary" is the slot index where a page after the first starts (one per divider).
+ */
+object HomePageLayout {
+    const val PREF_KEY = "HOME_PAGE_SIZES"
+
+    /** Bumped on every save so Compose readers re-read the layout. */
+    var version by mutableIntStateOf(0)
+        private set
+
+    /** The favorites being edited but not saved yet, in order (set by Edit Favorites). */
+    var draftApps: (() -> List<AppListItem>)? = null
+
+    fun bump() { version++ }
+
+    fun parse(raw: String?): List<Int>? {
+        if (raw.isNullOrBlank()) return null
+        return raw.split(',').map { it.trim().toIntOrNull() ?: return null }
+    }
+
+    fun encode(sizes: List<Int>): String = sizes.joinToString(",")
+
+    fun isValid(sizes: List<Int>?, slots: Int, pages: Int): Boolean =
+        sizes != null && pages >= 1 && sizes.size == pages && sizes.all { it >= 0 } && sizes.sum() == slots
+
+    /** Stock inkOS: ceil(slots / pages) per page, the remainder on later pages (some may be empty). */
+    fun evenSizes(slots: Int, pages: Int): List<Int> {
+        val p = pages.coerceAtLeast(1)
+        val per = if (slots <= 0) 0 else (slots + p - 1) / p
+        return List(p) { i -> (slots - i * per).coerceIn(0, per) }
+    }
+
+    /** The saved layout if it still fits [slots] and [pages], else null. */
+    fun savedSizes(context: Context, slots: Int, pages: Int): List<Int>? =
+        try {
+            parse(Prefs(context).homePageSizes)?.takeIf { isValid(it, slots, pages) }
+        } catch (_: Exception) { null }
+
+    fun sizesFor(context: Context, slots: Int, pages: Int): List<Int> =
+        savedSizes(context, slots, pages) ?: evenSizes(slots, pages)
+
+    fun save(context: Context, sizes: List<Int>) {
+        Prefs(context).homePageSizes = encode(sizes)
+        bump()
+    }
+
+    fun boundaries(sizes: List<Int>): List<Int> {
+        val out = ArrayList<Int>()
+        var acc = 0
+        for (i in 0 until sizes.size - 1) { acc += sizes[i]; out.add(acc) }
+        return out
+    }
+
+    fun sizesFromBoundaries(boundaries: List<Int>, slots: Int): List<Int> {
+        val edges = listOf(0) + boundaries + listOf(slots)
+        return edges.zipWithNext { a, b -> (b - a).coerceAtLeast(0) }
+    }
+
+    fun <T> split(items: List<T>, sizes: List<Int>): List<List<T>> {
+        var start = 0
+        return sizes.map { n ->
+            val from = start.coerceAtMost(items.size)
+            val to = (start + n).coerceAtMost(items.size)
+            start += n
+            items.subList(from, to).toList()
+        }
+    }
+
+    /** Home pages for [items]: the saved layout when it fits, else stock `chunked(appsPerPage)`. */
+    @Composable
+    fun <T> rememberPages(items: List<T>, appsPerPage: Int, totalPages: Int): List<List<T>> {
+        val context = LocalContext.current
+        val v = version
+        return remember(items, appsPerPage, totalPages, v) {
+            savedSizes(context, items.size, totalPages)?.let { split(items, it) }
+                ?: items.chunked(appsPerPage.coerceAtLeast(1))
+        }
+    }
+
+    /** Edit Favorites: how many page dividers sit right after favorite [favIndex]. */
+    @Composable
+    fun rememberBreaksAfter(favIndex: Int, slots: Int, pages: Int): Int {
+        val context = LocalContext.current
+        val v = version
+        val bounds = remember(slots, pages, v) {
+            try {
+                val p = Prefs(context)
+                boundaries(sizesFor(context, p.homeAppsNum, p.homePagesNum))
+            } catch (_: Exception) { emptyList() }
+        }
+        return bounds.count { it == favIndex + 1 }
+    }
+
+    /** Dashed line(s) under a row, one per divider (two or more = empty pages in between). */
+    fun pageBreakModifier(breaks: Int, color: Color): Modifier =
+        if (breaks <= 0) Modifier else Modifier.drawBehind {
+            val dashW = 6.dp.toPx()
+            val gap = 4.dp.toPx()
+            val sw = 1.dp.toPx()
+            val step = 3.dp.toPx()
+            for (k in 0 until breaks.coerceAtMost(4)) {
+                val y = size.height - k * step
+                var x = 0f
+                while (x < size.width) {
+                    drawLine(color, Offset(x, y), Offset((x + dashW).coerceAtMost(size.width), y), sw)
+                    x += dashW + gap
+                }
+            }
+        }
+}
