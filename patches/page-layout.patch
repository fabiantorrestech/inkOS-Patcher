+/*
+ * inkOS-Patcher: Arrange Pages ("page-layout" patch).
+ *
+ * Lists the home slots in order with one divider per page break. Drag a divider (or tap
+ * its arrows) to move apps between pages. Dividers stop at their neighbours and at the
+ * top and bottom of the list; two dividers together make an empty page. Save stores the
+ * sizes (see HomePageLayout) and the new page count.
+ */
+
+/** Button for the "home apps and pages" sheet. [onPagesChanged] gets the page count after Save. */
+@Composable
+fun ArrangePagesButton(onPagesChanged: (Int) -> Unit) {
+    var open by remember { mutableStateOf(false) }
+    val textColor = Theme.colors.text
+    Box(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, textColor, RoundedCornerShape(8.dp))
+            .clickable { open = true }
+            .padding(vertical = 12.dp, horizontal = 16.dp),
+        contentAlignment = Alignment.Center
+    ) {
+        Text(text = stringResource(R.string.page_layout_open), style = SettingsTheme.typography.item, color = textColor)
+    }
+    if (open) {
+        PageLayoutEditor(
+            onDismiss = { open = false },
+            onSaved = { pages ->
+                open = false
+                onPagesChanged(pages)
+            }
+        )
+    }
+}
+
+private fun slotLabel(context: Context, app: AppListItem?): Pair<String, Boolean> {
+    val pkg = app?.activityPackage.orEmpty()
+    return when {
+        app == null || pkg.isEmpty() -> context.getString(R.string.page_layout_empty_slot) to true
+        pkg == Constants.SEPARATOR_EMPTY -> context.getString(R.string.separator_empty) to true
+        pkg == Constants.SEPARATOR_EM_DASH -> context.getString(R.string.separator_em_dash) to true
+        pkg == Constants.SEPARATOR_DOTS -> context.getString(R.string.separator_dots) to true
+        else -> app.label.ifBlank { pkg } to false
+    }
+}
+
+private fun tick() {
+    try { VibrationHelper.trigger(VibrationHelper.Effect.SELECT) } catch (_: Exception) {}
+}
+
+@Composable
+fun PageLayoutEditor(onDismiss: () -> Unit, onSaved: (Int) -> Unit) {
+    val context = LocalContext.current
+    val density = LocalDensity.current
+    val prefs = remember { Prefs(context) }
+    val slots = remember { prefs.homeAppsNum.coerceAtLeast(0) }
+    val maxPages = remember {
+        val max = try {
+            Constants.updateMaxHomePages(context)
+            Constants.MAX_HOME_PAGES
+        } catch (_: Exception) { Constants.DEFAULT_MAX_HOME_PAGES }
+        max.coerceAtLeast(1)
+    }
+    val labels = remember {
+        val draft = try { HomePageLayout.draftApps?.invoke() } catch (_: Exception) { null }
+        List(slots) { i ->
+            val app = if (draft != null) draft.getOrNull(i) else try { prefs.getHomeAppModel(i) } catch (_: Exception) { null }
+            slotLabel(context, app)
+        }
+    }
+    // One boundary per divider: the slot index where the next page starts. Always sorted.
+    val bounds = remember {
+        val pages = prefs.homePagesNum.coerceIn(1, maxPages)
+        HomePageLayout.boundaries(HomePageLayout.sizesFor(context, slots, pages)).toMutableStateList()
+    }
+    var dragIndex by remember { mutableStateOf<Int?>(null) }
+    var dragOffset by remember { mutableFloatStateOf(0f) }
+    var scrollToEndRequest by remember { mutableIntStateOf(0) }
+    val scrollState = rememberScrollState()
+    val rowHeight = 48.dp
+    val rowPx = with(density) { rowHeight.toPx() }
+    val textColor = Theme.colors.text
+    val bg = Theme.colors.background
+
+    fun lo(i: Int) = if (i <= 0) 0 else bounds[i - 1]
+    fun hi(i: Int) = if (i >= bounds.lastIndex) slots else bounds[i + 1]
+    fun moveTo(i: Int, target: Int) {
+        if (i !in bounds.indices) return
+        val clamped = target.coerceIn(lo(i), hi(i))
+        if (clamped != bounds[i]) {
+            bounds[i] = clamped
+            tick()
+        }
+    }
+
+    LaunchedEffect(scrollToEndRequest) {
+        if (scrollToEndRequest > 0) scrollState.animateScrollTo(scrollState.maxValue)
+    }
+
+    Dialog(onDismissRequest = onDismiss, properties = DialogProperties(usePlatformDefaultWidth = false)) {
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(bg)
+                .padding(horizontal = 16.dp, vertical = 12.dp)
+        ) {
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.SpaceBetween,
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                HeaderAction(stringResource(R.string.page_layout_cancel)) { onDismiss() }
+                Text(text = stringResource(R.string.page_layout_title), style = SettingsTheme.typography.title, color = textColor)
+                HeaderAction(stringResource(R.string.page_layout_save)) {
+                    val sizes = HomePageLayout.sizesFromBoundaries(bounds.toList(), slots)
+                    HomePageLayout.save(context, sizes)
+                    onSaved(sizes.size)
+                }
+            }
+            Text(
+                text = stringResource(R.string.page_layout_hint),
+                style = SettingsTheme.typography.body,
+                color = textColor.copy(alpha = 0.7f),
+                modifier = Modifier.padding(vertical = 8.dp)
+            )
+
+            Column(
+                modifier = Modifier
+                    .weight(1f)
+                    .fillMaxWidth()
+                    .verticalScroll(scrollState)
+            ) {
+                PageLine(text = stringResource(R.string.page_layout_page, 1), height = rowHeight)
+                var pageIsEmpty = true
+                for (p in 0..slots) {
+                    for (i in bounds.indices) {
+                        if (bounds[i] != p) continue
+                        if (pageIsEmpty) EmptyPageRow(rowHeight)
+                        val dragging = dragIndex == i
+                        val offset = if (dragging) {
+                            dragOffset.coerceIn((lo(i) - bounds[i]) * rowPx, (hi(i) - bounds[i]) * rowPx)
+                        } else 0f
+                        androidx.compose.runtime.key("divider_$i") {
+                            DividerRow(
+                                text = stringResource(R.string.page_layout_page, i + 2),
+                                height = rowHeight,
+                                offsetY = offset,
+                                dragging = dragging,
+                                canUp = bounds[i] > lo(i),
+                                canDown = bounds[i] < hi(i),
+                                onDragStart = {
+                                    dragIndex = i
+                                    dragOffset = 0f
+                                },
+                                onDrag = { amount -> dragOffset += amount },
+                                onDragEnd = {
+                                    val from = dragIndex
+                                    if (from != null && from in bounds.indices) {
+                                        moveTo(from, bounds[from] + (dragOffset / rowPx).roundToInt())
+                                    }
+                                    dragIndex = null
+                                    dragOffset = 0f
+                                },
+                                onUp = { moveTo(i, bounds[i] - 1) },
+                                onDown = { moveTo(i, bounds[i] + 1) },
+                                onRemove = {
+                                    if (i in bounds.indices) {
+                                        bounds.removeAt(i)
+                                        tick()
+                                    }
+                                }
+                            )
+                        }
+                        pageIsEmpty = true
+                    }
+                    if (p < slots) {
+                        val (label, dim) = labels[p]
+                        SlotRow(label = label, dim = dim, height = rowHeight)
+                        pageIsEmpty = false
+                    }
+                }
+                if (pageIsEmpty) EmptyPageRow(rowHeight)
+            }
+
+            Text(
+                text = stringResource(R.string.page_layout_count, bounds.size + 1, maxPages),
+                style = SettingsTheme.typography.body,
+                color = textColor.copy(alpha = 0.7f),
+                modifier = Modifier.padding(top = 8.dp)
+            )
+            Row(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(top = 8.dp),
+                horizontalArrangement = Arrangement.spacedBy(12.dp)
+            ) {
+                FooterButton(
+                    text = stringResource(R.string.page_layout_add),
+                    enabled = bounds.size + 1 < maxPages,
+                    modifier = Modifier.weight(1f)
+                ) {
+                    bounds.add(slots) // new empty last page; drag it up to fill it
+                    tick()
+                    scrollToEndRequest++
+                }
+                FooterButton(
+                    text = stringResource(R.string.page_layout_even),
+                    enabled = true,
+                    modifier = Modifier.weight(1f)
+                ) {
+                    val even = HomePageLayout.boundaries(HomePageLayout.evenSizes(slots, bounds.size + 1))
+                    bounds.clear()
+                    bounds.addAll(even)
+                    tick()
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun HeaderAction(text: String, onClick: () -> Unit) {
+    Text(
+        text = text,
+        style = SettingsTheme.typography.item,
+        color = Theme.colors.text,
+        modifier = Modifier
+            .clickable(indication = null, interactionSource = remember { MutableInteractionSource() }) { onClick() }
+            .padding(vertical = 8.dp, horizontal = 4.dp)
+    )
+}
+
+@Composable
+private fun FooterButton(text: String, enabled: Boolean, modifier: Modifier = Modifier, onClick: () -> Unit) {
+    val color = Theme.colors.text.copy(alpha = if (enabled) 1f else 0.35f)
+    Box(
+        modifier = modifier
+            .border(1.dp, color, RoundedCornerShape(8.dp))
+            .clickable(enabled = enabled) { onClick() }
+            .padding(vertical = 12.dp),
+        contentAlignment = Alignment.Center
+    ) {
+        Text(text = text, style = SettingsTheme.typography.item, color = color, maxLines = 1)
+    }
+}
+
+@Composable
+private fun PageLine(text: String, height: Dp) {
+    val color = Theme.colors.text.copy(alpha = 0.6f)
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .height(height),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Text(text = text, style = SettingsTheme.typography.item, color = color, maxLines = 1)
+        Spacer(Modifier.size(8.dp))
+        Box(Modifier.weight(1f).height(1.dp).background(color))
+    }
+}
+
+@Composable
+private fun SlotRow(label: String, dim: Boolean, height: Dp) {
+    val color = Theme.colors.text
+    Box(
+        modifier = Modifier
+            .fillMaxWidth()
+            .height(height)
+            .padding(start = 32.dp),
+        contentAlignment = Alignment.CenterStart
+    ) {
+        Text(
+            text = label,
+            style = SettingsTheme.typography.item,
+            color = if (dim) color.copy(alpha = 0.5f) else color,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis
+        )
+    }
+}
+
+@Composable
+private fun EmptyPageRow(height: Dp) {
+    SlotRow(label = stringResource(R.string.page_layout_empty_page), dim = true, height = height)
+}
+
+@Composable
+private fun DividerRow(
+    text: String,
+    height: Dp,
+    offsetY: Float,
+    dragging: Boolean,
+    canUp: Boolean,
+    canDown: Boolean,
+    onDragStart: () -> Unit,
+    onDrag: (Float) -> Unit,
+    onDragEnd: () -> Unit,
+    onUp: () -> Unit,
+    onDown: () -> Unit,
+    onRemove: () -> Unit
+) {
+    val textColor = Theme.colors.text
+    val bg = Theme.colors.background
+    val fg = if (dragging) bg else textColor
+    val start by rememberUpdatedState(onDragStart)
+    val drag by rememberUpdatedState(onDrag)
+    val end by rememberUpdatedState(onDragEnd)
+    Row(
+        modifier = Modifier
+            .zIndex(if (dragging) 1f else 0f)
+            .graphicsLayer { translationY = offsetY }
+            .fillMaxWidth()
+            .height(height)
+            .background(if (dragging) textColor else bg, RoundedCornerShape(8.dp))
+            .pointerInput(Unit) {
+                detectVerticalDragGestures(
+                    onDragStart = { start() },
+                    onDragEnd = { end() },
+                    onDragCancel = { end() }
+                ) { change, amount ->
+                    change.consume()
+                    drag(amount)
+                }
+            }
+            .padding(horizontal = 4.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Icon(imageVector = Icons.Rounded.DragHandle, contentDescription = null, tint = fg)
+        Spacer(Modifier.size(8.dp))
+        Text(text = text, style = SettingsTheme.typography.item, color = fg, maxLines = 1)
+        Spacer(Modifier.size(8.dp))
+        Box(Modifier.weight(1f).height(2.dp).background(fg))
+        SmallIcon(Icons.Rounded.KeyboardArrowUp, fg, canUp, onUp)
+        SmallIcon(Icons.Rounded.KeyboardArrowDown, fg, canDown, onDown)
+        SmallIcon(Icons.Rounded.Close, fg, true, onRemove)
+    }
+}
+
+@Composable
+private fun SmallIcon(icon: ImageVector, tint: androidx.compose.ui.graphics.Color, enabled: Boolean, onClick: () -> Unit) {
+    Box(
+        modifier = Modifier
+            .size(40.dp)
+            .clickable(enabled = enabled, indication = null, interactionSource = remember { MutableInteractionSource() }) { onClick() },
+        contentAlignment = Alignment.Center
+    ) {
+        Icon(imageVector = icon, contentDescription = null, tint = tint.copy(alpha = if (enabled) 1f else 0.3f))
+    }
+}
