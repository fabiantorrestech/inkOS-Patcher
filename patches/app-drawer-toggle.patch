+package com.github.gezimos.inkos.ui
+
+import android.content.Context
+import com.github.gezimos.inkos.data.Prefs
+
+/**
+ * inkOS-Patcher: master On/Off switch for the app drawer.
+ *
+ * Off: everything that opens the drawer to browse apps does nothing: the "App Drawer"
+ * gesture/shortcut action, the Menu key and Backspace on Home, the "App Drawer" home
+ * shortcut and the OPEN_APP_DRAWER intent. The Search action and typing on Home still
+ * open search. Settings and the home-app/favorites/hidden-app pickers are unaffected.
+ */
+object AppDrawerToggle {
+    const val PREF_KEY = "APP_DRAWER_ENABLED"
+    const val DEFAULT = true
+
+    /** True when the drawer may be opened. A failed prefs read keeps stock behavior. */
+    fun isEnabled(context: Context): Boolean =
+        try { Prefs(context).appDrawerEnabled } catch (_: Exception) { DEFAULT }
+}
